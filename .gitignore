*.safetensors
*.bin
*.part
*.onnx
*.pt
*.pth
*.ckpt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Copias y temporales ---
*.bak
*.tmp
*.log
crash.log

