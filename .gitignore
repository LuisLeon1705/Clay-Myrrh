/pagina.*
/respuesta.*
/index.html
/css/
/js/
/documentos/

# --- Editores y sistema ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# --- Configuración local de agentes ---
.claude/settings.local.json
.gemini/
